# =============================================================================
# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
# =============================================================================
# This file holds NO secrets and must never hold any. Runtime secrets (GROQ_API_KEY,
# API_KEY_HASHES) go into SSM Parameter Store as SecureString and are read by the
# Lambda execution role — a value passed through Terraform is written to
# terraform.tfstate in plaintext, which defeats the point of encrypting it.
# =============================================================================

# Required. Budget alerts are emailed here — no default, because a budget nobody
# is notified about is decoration.
alert_email = "you@example.com"

# Optional — defaults shown.
# aws_region  = "eu-west-1"   # af-south-1 is opt-in and ~15-20% dearer; see variables.tf
# environment = "dev"

# monthly_budget_usd      = 5
# daily_budget_usd        = 1
# actual_alert_thresholds = [50, 80, 100]
# budget_start_date       = "2026-08-01_00:00"
