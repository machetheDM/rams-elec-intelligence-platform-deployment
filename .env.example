# =============================================================================
# Rams @Elec Intelligence Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your keys.
# [REQUIRED] = must be set for the service to function
# [OPTIONAL] = service degrades gracefully without it

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rams_elec
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/rams_elec

# =============================================================================
# NEXT.JS / NEXTAUTH (REQUIRED)
# =============================================================================
AUTH_SECRET=generate-a-random-secret-here                       # [REQUIRED] openssl rand -base64 32
AUTH_URL=http://localhost:3000                                   # [REQUIRED]

# =============================================================================
# ADMIN (REQUIRED)
# =============================================================================
ADMIN_TOKEN=rams-elec-admin-2026                                 # [REQUIRED]

# =============================================================================
# GROQ LLM API (REQUIRED for AI features)
# =============================================================================
# Free tier available at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here                                  # [REQUIRED]

# =============================================================================
# TWILIO (REQUIRED for WhatsApp/SMS notifications)
# =============================================================================
TWILIO_ACCOUNT_SID=your_twilio_sid                              # [REQUIRED]
TWILIO_AUTH_TOKEN=your_twilio_token                             # [REQUIRED]
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886                      # [REQUIRED]
TWILIO_SMS_FROM=+1234567890                                     # [OPTIONAL]

# =============================================================================
# ESKOMSEPUSH (REQUIRED for load-shedding)
# =============================================================================
# Free tier available at https://eskomsepush.gumroad.com/l/api
ESKOM_SE_PUSH_API_KEY=your_esp_key_here                         # [REQUIRED]

# =============================================================================
# AIRFLOW (REQUIRED for ETL orchestration)
# =============================================================================
AIRFLOW__CORE__FERNET_KEY=generate-with-python                  # [REQUIRED]
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/rams_elec  # [REQUIRED]

# =============================================================================
# N8N (REQUIRED for automation workflows)
# =============================================================================
N8N_BASIC_AUTH_USER=admin                                       # [REQUIRED]
N8N_BASIC_AUTH_PASSWORD=change-me-in-production                 # [REQUIRED]
N8N_WEBHOOK_URL=http://localhost:5678                           # [REQUIRED]

# =============================================================================
# MLFLOW (OPTIONAL — for model tracking)
# =============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000                       # [OPTIONAL]

# =============================================================================
# AWS DATA LAKE (OPTIONAL — Phase 0 of docs/aws-vendor-upgrade-plan.md)
# =============================================================================
# etl/loaders/s3_loader.py writes Gold-layer Parquet here alongside the
# existing Postgres load. Left unset, the loader reports "skipped" and the
# pipeline behaves exactly as it did before this was added — Postgres remains
# the source of truth regardless.
#
# Bucket name comes from `terraform output artifacts_bucket` after
# terraform/aws/ has been applied — do not invent a name here, Terraform's is
# the one IAM actually grants access to.
RAMS_ELEC_ARTIFACTS_BUCKET=                                     # [OPTIONAL] terraform output artifacts_bucket
AWS_REGION=af-south-1                                            # [OPTIONAL] must match terraform/aws/variables.tf aws_region

# services/triage's quote estimator backend — see services/triage/.env.example
# for the full explanation. Stays "local" until the SageMaker endpoint
# (Phase 1) has actually been deployed.
MODEL_BACKEND=local                                             # [OPTIONAL] local | sagemaker
SAGEMAKER_ENDPOINT_NAME=rams-elec-quote-estimator               # [OPTIONAL]

# =============================================================================
# INTERNAL SERVICE URLS (REQUIRED for inter-service communication)
# =============================================================================
TRIAGE_SERVICE_URL=http://localhost:8001                        # [REQUIRED]
LOADSHEDDING_SERVICE_URL=http://localhost:8002                  # [REQUIRED]
CHATBOT_SERVICE_URL=http://localhost:8003                       # [REQUIRED]
DISPATCH_SERVICE_URL=http://localhost:8004                      # [REQUIRED]
CREW_SERVICE_URL=http://localhost:8005
SENTIMENT_SERVICE_URL=http://localhost:8006                     # [REQUIRED]                          # [REQUIRED]

# Server-side only — the X-API-Key the security/ middleware requires for
# service-to-service calls (see security/auth/api_key_middleware.py).
# NEVER prefix this with NEXT_PUBLIC_: it must not reach the browser.
#
# This value is committed to a public repository. It is a local-development
# convenience, not a credential — see APP_ENV below.
INTERNAL_API_KEY=rams-elec-frontend-2026                        # [REQUIRED]

# =============================================================================
# DEPLOYMENT ENVIRONMENT + API KEY ALLOWLIST
# =============================================================================
# APP_ENV gates whether the committed development keys are accepted at all.
#
#   development (default)  → API_KEY_HASHES optional; the three keys committed
#                            to this repo are accepted, with a loud warning.
#   anything else          → API_KEY_HASHES is REQUIRED. The service raises at
#                            import if it is unset, and also if it contains the
#                            hash of a committed development key. Both cases
#                            refuse to start rather than serve an open endpoint.
#
# "Anything else" includes typos and empty strings: an unrecognised environment
# fails closed, never open.
APP_ENV=development                                             # [OPTIONAL] development | staging | prod

# Comma-separated SHA-256 hex digests of the accepted API keys. Leave unset for
# local development. REQUIRED before anything is exposed publicly — a Lambda
# Function URL in particular (see terraform/aws/README.md).
#
# Generate a key and its hash:
#   python -c "import secrets, hashlib; k = secrets.token_urlsafe(32); print(k, hashlib.sha256(k.encode()).hexdigest())"
#
# Store the plaintext key in your password manager and the HASH here. In AWS,
# this belongs in SSM Parameter Store as a SecureString, never in a .tfvars file.
# API_KEY_HASHES=                                               # [REQUIRED when APP_ENV != development]

# =============================================================================
# SERVICE PORTS (OPTIONAL — defaults shown)
# =============================================================================
TRIAGE_PORT=8001                                                # [OPTIONAL]
LOADSHEDDING_PORT=8002                                          # [OPTIONAL]
CHATBOT_PORT=8003                                               # [OPTIONAL]
DISPATCH_PORT=8004                                              # [OPTIONAL]
CREW_PORT=8005                                                  # [OPTIONAL]
SENTIMENT_PORT=8006                                             # [OPTIONAL]

# CrewAI multi-agent triage (services/crew) — see services/crew/.env.example
CREW_MODEL=groq/llama-3.3-70b-versatile                         # [OPTIONAL] litellm provider-prefixed
CREW_MAX_ITER=5                                                 # [OPTIONAL] max reasoning loops per agent

# =============================================================================
# NEXT.JS PUBLIC (exposed to browser — prefix with NEXT_PUBLIC_)
# =============================================================================
NEXT_PUBLIC_TRIAGE_API_URL=http://localhost:8001                # [REQUIRED]
NEXT_PUBLIC_LOADSHEDDING_API_URL=http://localhost:8002          # [REQUIRED]
NEXT_PUBLIC_CHATBOT_API_URL=http://localhost:8003               # [REQUIRED]
NEXT_PUBLIC_DISPATCH_API_URL=http://localhost:8004              # [REQUIRED]
