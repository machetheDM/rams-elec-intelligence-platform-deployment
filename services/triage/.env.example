# Groq API key for LLM classification (free tier available at console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# PostgreSQL connection (same as Prisma DATABASE_URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ramsatelec

# MLflow tracking URI
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Service port
TRIAGE_PORT=8001

# Quote estimator backend: "local" (default, in-process .pkl, no AWS call) or
# "sagemaker" (invokes the Serverless Inference endpoint from
# terraform/aws/sagemaker.tf — requires enable_sagemaker_endpoint = true to
# have been applied). A SageMaker invocation failure falls back to the
# heuristic cost ranges, never to the local model, since MODEL_BACKEND is
# meant to say which backend you're evaluating.
MODEL_BACKEND=local
SAGEMAKER_ENDPOINT_NAME=rams-elec-quote-estimator
AWS_REGION=af-south-1
