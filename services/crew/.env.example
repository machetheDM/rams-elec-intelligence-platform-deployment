# CrewAI Triage Service
GROQ_API_KEY=gsk_your_key_here                  # [REQUIRED] crew is 503 without it

# Internal services the agent tools call
TRIAGE_SERVICE_URL=http://localhost:8001        # [REQUIRED]
DISPATCH_SERVICE_URL=http://localhost:8004      # [REQUIRED]
INTERNAL_API_KEY=rams-elec-frontend-2026        # [REQUIRED] X-API-Key for those calls

# Tuning
CREW_PORT=8005                                  # [OPTIONAL]
CREW_MODEL=groq/llama-3.3-70b-versatile         # [OPTIONAL] litellm provider-prefixed
CREW_TEMPERATURE=0.1                            # [OPTIONAL]
CREW_MAX_ITER=5                                 # [OPTIONAL] max reasoning loops per agent
CREW_TOOL_TIMEOUT=30                            # [OPTIONAL] seconds per tool HTTP call

# ---------------------------------------------------------------------------
# Alternative LLM backend: AWS Bedrock (see docs/benchmarks/bedrock-vs-groq.md)
# ---------------------------------------------------------------------------
# Swap CREW_MODEL to a bedrock/<model-id> value to route the crew's LLM calls
# through Bedrock instead of Groq — no other code change needed, see
# agents.py's build_llm(). Requires:
#   1. Model access granted in the AWS console for the chosen model
#      (Bedrock -> Model access — this is a manual, per-model opt-in AWS
#      requires and Terraform cannot grant)
#   2. AWS credentials resolvable by boto3's normal chain (below), NOT
#      Bedrock-specific env vars — there is no such thing
#
# CREW_MODEL=bedrock/anthropic.claude-3-haiku-20240307-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=af-south-1                          # [OPTIONAL] must match a region with model access granted
