# CrewAI Triage Service
GROQ_API_KEY=gsk_your_key_here                  # [REQUIRED] crew is 503 without it

# Internal services the agent tools call
TRIAGE_SERVICE_URL=http://localhost:8001        # [REQUIRED]
DISPATCH_SERVICE_URL=http://localhost:8004      # [REQUIRED]
INTERNAL_API_KEY=rams-elec-frontend-2026        # [REQUIRED] X-API-Key for those calls

# Tuning
CREW_PORT=8005                                  # [OPTIONAL]
CREW_MODEL=groq/llama-3.3-70b-versatile         # [OPTIONAL] litellm provider-prefixed
CREW_TEMPERATURE=0.1                            # [OPTIONAL]
CREW_MAX_ITER=5                                 # [OPTIONAL] max reasoning loops per agent
CREW_TOOL_TIMEOUT=30                            # [OPTIONAL] seconds per tool HTTP call
