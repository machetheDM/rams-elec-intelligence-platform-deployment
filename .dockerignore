# Repo-root .dockerignore — applies to any image built with context "."
# (currently: services/triage/Dockerfile, services/dispatch/Dockerfile,
# services/chatbot/Dockerfile, services/loadshedding/Dockerfile, and
# frontend/Dockerfile — the last of these needs frontend/ itself, so don't
# exclude it wholesale below; frontend/node_modules and frontend/.next are
# still excluded individually.)

.git/
.github/

# Node
**/node_modules/
frontend/.next/
frontend/out/

# Python
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/
**/*.egg-info/

# Env / secrets
.env
.env.*
!.env.example

# Docs, reports, terraform, misc large/unrelated content
docs/
reports/
terraform/
n8n/
airflow/
etl/
dashboard/
scripts/
ml/

# packages/db is needed only for its prisma/ schema (frontend/Dockerfile);
# everything else in it (generated client output, seed data) is unneeded.
packages/db/node_modules/
packages/db/generated/

# Editor / OS
.vscode/
.idea/
.DS_Store
